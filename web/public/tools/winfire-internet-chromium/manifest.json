{
  "manifest_version": 3,
  "name": "WinFIRE Internet Visibility",
  "description": "Privately report browser navigation metadata to an enrolled WinFIRE control plane.",
  "version": "0.1.0",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "alarms", "webNavigation", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "WinFIRE Internet Visibility" },
  "incognito": "not_allowed"
}
