PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
JWT_SECRET=replace-with-a-long-random-value
VAULT_MASTER_KEY=base64-encoded-32-byte-key
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=replace-with-a-unique-password
# Keep enabled for local/demo deployments; set false in production.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@winfire.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-demo-password
CORS_ORIGIN=http://localhost:3000
# Comma-separated Chrome/Edge/Firefox extension origins allowed to post Internet telemetry.
# Example: chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,moz-extension://<uuid>
EXTENSION_ORIGINS=
# WINRM_INSECURE_HTTP is a legacy deployment value; current connectors do not read it.
# HTTPS WinRM validates server certificates unless WINRM_TLS_VERIFY=false.
WINRM_TLS_VERIFY=true
# Event retention is configured in Administration (persisted log_retention_days).
SWEEP_INTERVAL_MINUTES=60
LOG_POLL_INTERVAL_SECONDS=120
LOG_POLL_CONCURRENCY=4
MFA_EVENT_POLL_SECONDS=30
AUTH_RATE_LIMIT=20
# Include every public or private address used by control-plane hosts so block rules cannot cut them off.
# WINFIRE_CONTROL_PLANE_IPS=192.0.2.10,2001:db8::10
# Set only to your trusted reverse proxy addresses/CIDRs so portal grants use the real client IP.
# TRUST_PROXY_CIDRS=127.0.0.1,::1
# Optional Entra portal provider. Register https://your-host/identity as the web redirect URI,
# add amr as an optional ID-token claim, and require MFA for this app with Conditional Access.
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=read-from-secret-manager
# For certificate authentication, provide the PEM values directly or use *_FILE paths. The RSA
# private key is used only to sign short-lived private_key_jwt assertions and is never returned.
# ENTRA_CLIENT_CERTIFICATE=-----BEGIN CERTIFICATE-----...
# ENTRA_CLIENT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# ENTRA_CLIENT_CERTIFICATE_FILE=/secure/entra-client.crt
# ENTRA_CLIENT_PRIVATE_KEY_FILE=/secure/entra-client.key
# HTTPS PUBLIC_BASE_URL also enables interactive MFA browser prompts on managed source workstations.
# Set these to deliver user invitations by email. Without SMTP, an admin receives a one-time link to share manually.
# PUBLIC_BASE_URL=https://winfire.example.com
# Source-initiated Windows Event Forwarding uses the embedded WS-Man receiver. Keep this secret in
# the deployment secret store; the server derives a different token for each configured node.
# WEF_SHARED_SECRET=read-from-secret-manager
# Enable the receiver from Administration → Logs and DNS after setting WEF_SHARED_SECRET.
# WEF_ENABLED is not read directly; the persisted setting is changed by the administrator.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=WinFire Secure <winfire@example.com>
# SMTP_USER=winfire@example.com
# SMTP_PASSWORD=read-from-secret-manager
# Optional shared HTTPS endpoint for users who enable webhook alerts in their profile.
# NOTIFICATION_WEBHOOK_URL=https://alerts.example.com/winfire
# Optional dedicated HMAC key for signed Internet browser policy payloads. JWT_SECRET is the
# fallback when this is not set; use a dedicated value in production.
# INTERNET_POLICY_SIGNING_SECRET=read-from-secret-manager
# Required together for HTTPS and the agent mTLS channel.
# TLS_CERT=/secure/server.crt
# TLS_KEY=/secure/server.key
# TLS_KEY_PASSPHRASE=read-from-secret-manager
# AGENT_CA_CERT=/secure/agent-ca.crt
# AGENT_CA_KEY=/secure/agent-ca.key
# AGENT_CA_PASSPHRASE=read-from-secret-manager
# Authenticode-signed WinFire.Agent.exe served over this HTTPS instance for remote deployment.
# AGENT_PACKAGE_PATH=/secure/packages/WinFire.Agent.exe
# Optional signed self-update package. If omitted, AGENT_PACKAGE_PATH is used.
# AGENT_UPDATE_PACKAGE_PATH=/secure/packages/WinFire.Agent.exe
# Package assembly version advertised to enrolled agents.
# AGENT_PACKAGE_VERSION=0.1.0
# AGENT_UPDATE_VERSION=0.1.0
# Optional SHA-1 certificate thumbprint pin for the approved executable signer (40 hex characters).
# AGENT_SIGNER_THUMBPRINT=0123456789ABCDEF0123456789ABCDEF01234567
