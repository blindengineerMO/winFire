<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <AgentPublishDir Condition="'$(AgentPublishDir)' == ''">$(MSBuildThisFileDirectory)..\dist\win-x64</AgentPublishDir>
    <DefineConstants>AgentPublishDir=$(AgentPublishDir)</DefineConstants>
  </PropertyGroup>
</Project>
